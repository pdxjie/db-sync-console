{
  "name": "sync-dog",
  "version": "0.1.3",
  "description": "SyncDog desktop database sync app.",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "backend:build": "scripts/build_backend_runtime.sh",
    "renderer:build": "vite --config desktop/renderer/vite.config.js build",
    "desktop": "npm run renderer:build && electron .",
    "desktop:dev": "npm run renderer:build && electron .",
    "desktop:pack": "scripts/build_desktop_app.sh dir",
    "desktop:dist": "scripts/build_desktop_app.sh dmg"
  },
  "build": {
    "appId": "com.pdxjie.syncdog",
    "productName": "同步犬",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "assets/**/*",
      "sync_tool/**/*",
      "requirements.txt",
      "requirements-build.txt",
      "config.example.json",
      "README.md"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/app-icon.icns",
      "target": [
        "dir",
        "dmg"
      ]
    }
  },
  "dependencies": {
    "@ant-design/icons": "5.3.7",
    "antd": "5.16.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.2.1",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "vite": "4.5.3"
  }
}
