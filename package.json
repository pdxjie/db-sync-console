{
  "name": "sync-dog",
  "version": "0.1.11",
  "description": "SyncDog desktop database sync app.",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "renderer:build": "vite --config desktop/renderer/vite.config.js build",
    "backend:build": "/usr/bin/arch -arm64 .venv/bin/python scripts/build_backend_runtime.py --platform darwin-arm64",
    "backend:build:win": "python scripts/build_backend_runtime.py --platform win32-x64",
    "desktop": "npm run renderer:build && electron .",
    "desktop:dev": "npm run renderer:build && electron .",
    "desktop:pack": "npm run renderer:build && npm run backend:build && electron-builder --mac dir --arm64",
    "desktop:dist": "npm run renderer:build && npm run backend:build && electron-builder --mac dmg --arm64",
    "desktop:dist:win": "npm run renderer:build && npm run backend:build:win && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.pdxjie.syncdog",
    "productName": "同步犬",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "assets/**/*",
      "config.example.json",
      "README.md"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/app-icon.icns",
      "target": [
        "dir",
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "artifactName": "SyncDog-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "同步犬"
    }
  },
  "dependencies": {
    "@ant-design/icons": "5.3.7",
    "antd": "5.16.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.2.1",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "vite": "4.5.3"
  }
}
